# Required
DATABASE_URL=postgres://user:pass@host:5432/agent
OPENROUTER_API_KEY=
MASTER_KEY=                 # any long random string; encrypts stored credentials
PUBLIC_URL=https://your.domain   # where the connect links and OAuth callback live

# iMessage (Photon Spectrum project)
PROJECT_ID=
PROJECT_SECRET=
# SPECTRUM_WEBHOOK_SECRET=  # set to receive signed webhooks at /webhooks/photon instead of streaming

# Google (Gmail, Calendar, Contacts, Drive): OAuth client with redirect ${PUBLIC_URL}/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hands
BROWSERBASE_API_KEY=
# EXA_API_KEY= or BRAVE_API_KEY=   # web search; without either, keyless DuckDuckGo

# Budgets and models (defaults shown)
# MODEL_CAP_USD=5
# BROWSER_CAP_SESSIONS=20
# PLATFORM_TZ=America/New_York
# MODEL_CHEAP=z-ai/glm-5.3-flash
# MODEL_CHEAP_FALLBACK=deepseek/deepseek-v4-flash
# MODEL_SMART=z-ai/glm-5.3
# MODEL_SMART_FALLBACK=openai/gpt-6-sol
# MEDIA_MODEL=google/gemini-2.5-flash

# Web sign-in (Clerk); the web app links to the phone with a texted code
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# CLERK_AUTHORIZED_PARTIES=https://other.origin
