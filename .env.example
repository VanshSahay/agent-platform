# Model. OpenRouter is the default door (GLM 5.3 for the agent, GLM 5.3 flash for small calls).
# With ANTHROPIC_API_KEY instead, Claude Opus 5.5 and Haiku 5.5 are used directly.
OPENROUTER_API_KEY=
# MODEL=z-ai/glm-5.3
# MODEL_SMALL=z-ai/glm-5.3-flash
# ANTHROPIC_API_KEY=

# Storage: one SQLite file (the directory is created on first run).
DB_PATH=data/circle.sqlite

# Web server and the URL people reach it at. HOST defaults to 127.0.0.1 without Clerk and 0.0.0.0 with it;
# the server refuses a non-loopback HOST unless Clerk sign-in and MASTER_KEY are both configured.
PORT=3000
# HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000

# Encrypts members' credentials in the vault. Required when HOST is not loopback.
MASTER_KEY=

# Shared secret for machines: POST /api/events (webhooks) and POST /api/tick (cron) with
# `Authorization: Bearer <EVENT_TOKEN>`. Without it only a signed-in agent owner may call them.
EVENT_TOKEN=

# Sign-in for the owner UI (Clerk). Without these, the UI trusts the "You" picker (local dev only).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Chat channels through Photon Spectrum: iMessage, WhatsApp Business, Telegram, Slack. Without these, the web channel only.
PROJECT_ID=
PROJECT_SECRET=
# CHANNELS=imessage,whatsapp,telegram,slack

# Browser hand (Browserbase). Without it, browse_page reads pages as text through Jina Reader (no clicks or forms).
BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Web search. Default is Exa's public endpoint (keyless, via the Agent Reach channel), which answers
# local-business queries with names, ratings and phone numbers. BRAVE_API_KEY switches to Brave;
# SEARCH=duckduckgo uses the keyless DuckDuckGo scrape (rate-limited from servers).
# BRAVE_API_KEY=
# SEARCH=exa

# LOCAL=1 makes any run safe for local testing: sign-in and iMessage off, loopback only (`bun run local`).
# LOCAL=

# What the assistant is called. On first run it is created with its owner's seat; people and rooms come after.
ASSISTANT_NAME=Pip

# Scheduler tick, milliseconds.
TICK_MS=30000

# Phone calls and community posting are still fakes; real adapters implement src/tools/hands.ts.

# ---- The catalogue's services. Each is optional; without it the matching tools say so and the agent asks for a connect link.
# Google Workspace (Gmail, Calendar, Drive, Sheets, Forms, Slides): one OAuth app; people connect their own account in Settings.
# Redirect URI to register: <PUBLIC_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The assistant's own mailbox: AgentMail (send and receive) or Resend (send only).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# RESEND_API_KEY=
# EMAIL_FROM=pip@yourdomain.com
# Voice notes (text_to_speech) and image generation.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# IMAGE_MODEL=google/gemini-2.5-flash-image
# Phone calls (place_call, place_vendor_call) through Vapi; SMS through Twilio.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Single-use cards for checkout_cart (Stripe Issuing).
STRIPE_SECRET_KEY=
STRIPE_CARDHOLDER_ID=
# Slack, MCP servers and HTTP APIs are connected per person under Settings → Connections, not here.
