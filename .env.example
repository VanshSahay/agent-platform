# Copy to .env and fill in. Secrets live only in .env (gitignored); production values live in Fly's secrets (scripts/fly-setup.sh copies them).
OPENROUTER_API_KEY=          # model door (deepseek/deepseek-v4.1-flash-1017); or ANTHROPIC_API_KEY for the Anthropic door
MASTER_KEY=                  # encrypts members' credentials in the vault; required off loopback; generate a fresh one per deployment
PUBLIC_URL=                  # where the app is reachable (invite links, artifact links, OAuth callbacks)
OWNER_EMAIL=            # with sign-in on: the address that may claim the owner seat on a fresh deployment
CLERK_SECRET_KEY=            # sign-in; dev keys for local, the production instance for a real audience
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=    # comma-separated origins allowed to sign in, e.g. http://localhost:3000,https://circle-agent.fly.dev
BROWSERBASE_API_KEY=         # hosted browser for signed-in sites; local Chrome and Jina cover reads without it
BROWSERBASE_# iMessage: Photon Spectrum cloud (PROJECT_ID + PROJECT_SECRET), or IMESSAGE_MODE=local to use this Mac's own Messages app (macOS only, Full Disk Access; group chats work, no reactions).
IMESSAGE_MODE=
PROJECT_ID=
PROJECT_ID=                  # Photon (iMessage / WhatsApp / Telegram / Slack channels)
PROJECT_SECRET=
CHANNELS=imessage
IMESSAGE_PHONE=               # the line's number as shown in the Photon dashboard, so Settings → Channels can display it
# Optional hands: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, AGENTMAIL_API_KEY, AGENTMAIL_INBOX, RESEND_API_KEY, EMAIL_FROM,
# VAPI_API_KEY, VAPI_PHONE_NUMBER_ID, TWILIO_*, ELEVENLABS_API_KEY, STRIPE_SECRET_KEY, BRAVE_API_KEY, CHROME_PATH, DB_PATH, HOST, PORT
# Hosting: Fly.io app circle-agent (fly.toml). `scripts/fly-setup.sh` once, then `fly deploy`.
# Hotel rates (LiteAPI / Nuitée Connect): net wholesale prices next to the public price. A sand_ key is live content, no booking.
LITEAPI_API_KEY=
# Hotel comparison: our margin on the net rate, the site people book on (search links), and public prices via Apify (console.apify.com → Settings → API tokens):
# Booking.com by hotel name by default, about $0.04 a comparison; PUBLIC_RATES=google for Google's seller ladder at about $0.20.
HOTEL_MARKUP_PCT=0
HOTEL_SITE_URL=
APIFY_TOKEN=
# Spend monitor, operator only (`bun run spend` locally, `bun run spend:prod` against Fly). Nobody in the product sees it. Model and Apify costs come from the providers;
# browser time is priced per session-hour (0.10 is the Startup overage rate, 0.12 Developer; 0 if inside your plan's hours);
# hosting has no per-run figure, so a monthly Fly bill is prorated over the window.
BROWSERBASE_USD_PER_HOUR=0.10
FLY_USD_PER_MONTH=0
# Operations (docs/runbook.md): who reads the error log at /api/ops/errors (sign-in emails; default the owner of the oldest assistant),
# the token webhooks and an external cron use for POST /api/events and /api/tick, and how many daily database copies to keep.
OPERATOR_EMAILS=
EVENT_TOKEN=
BACKUPS_KEPT=7
