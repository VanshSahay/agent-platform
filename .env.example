# Model. OpenRouter is the default door (GLM 5.3 for the agent, GLM 5.3 flash for small calls).
# With ANTHROPIC_API_KEY instead, Claude Opus 5.5 and Haiku 5.5 are used directly.
OPENROUTER_API_KEY=
# MODEL=z-ai/glm-5.3
# MODEL_SMALL=z-ai/glm-5.3-flash
# ANTHROPIC_API_KEY=

# Storage: one SQLite file (the directory is created on first run).
DB_PATH=data/circle.sqlite

# Web server and the URL people reach it at.
PORT=3000
PUBLIC_URL=http://localhost:3000

# Sign-in for the owner UI (Clerk). Without these, the UI trusts the "You" picker (local dev only).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# iMessage through Photon Spectrum. Without these, the web channel only.
PROJECT_ID=
PROJECT_SECRET=

# Browser hand (Browserbase). Without it, browse_page is a fake.
BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Seed a family circle (Ellie, Ben, Mum, Uncle Wei and the agent Pip) on an empty database.
SEED_DEMO=1

# Scheduler tick, milliseconds.
TICK_MS=30000

# Search, phone and community posting are still fakes; real adapters implement src/tools/hands.ts.
