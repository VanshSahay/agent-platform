# Model. The SDK also accepts an `ant auth login` profile instead of a key.
ANTHROPIC_API_KEY=

# Storage (SQLite file; the directory is created on first run).
DB_PATH=data/circle.sqlite

# Web server.
PORT=3000

# Seed a family circle (Ellie, Ben, Mum, Uncle Wei and the agent Pip) on an empty database.
SEED_DEMO=1

# Scheduler tick, milliseconds.
TICK_MS=30000

# Hands. Without these, the fakes run: searches return nothing, calls "complete",
# community posts get no replies. Real adapters implement src/tools/hands.ts.
# SEARCH_PROVIDER=
# PHONE_PROVIDER=
# COMMUNITY_PROVIDER=
