# Temporal worker (Node — Temporal's SDK isn't supported on Bun). Scale horizontally: run as many as you need.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev && npm install tsx
COPY . .
ENV NODE_ENV=production ENGINE=temporal
CMD ["npx", "tsx", "src/temporal/worker.ts"]
