# API server + channels + web app (Bun).
FROM oven/bun:1.3
WORKDIR /app
# ffmpeg: iMessage voice memos (.caf) are transcoded to MP3 before transcription
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile --production
COPY . .
ENV NODE_ENV=production ENGINE=temporal PORT=3000
EXPOSE 3000
CMD ["bun", "run", "src/index.ts"]
