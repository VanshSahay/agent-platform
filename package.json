{
  "name": "circle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal agent that lives in the group chats you already have.",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "local": "LOCAL=1 SEED_DEMO=1 bun run src/main.ts",
    "imessage:local": "CLERK_PUBLISHABLE_KEY= CLERK_SECRET_KEY= PROJECT_ID= PROJECT_SECRET= HOST=127.0.0.1 PORT=3300 IMESSAGE_MODE=local DB_PATH=data/local-im.sqlite bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "eval": "bun run src/eval/run.ts",
    "harness": "bun run src/eval/harness-run.ts",
    "spend": "bun run src/spend-cli.ts",
    "smoke:hotels": "bun run scripts/smoke-hotels.ts",
    "spend:prod": "fly ssh console --app circle-agent -C \"bun run src/spend-cli.ts\"",
    "lint": "biome check src test web/app.js",
    "format": "biome format --write src test web/app.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@clerk/backend": "^3.23.2",
    "@spectrum-ts/imessage-local": "^12.14.0",
    "playwright-core": "^1.64.0",
    "qrcode": "^1.5.4",
    "spectrum-ts": "^12.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
